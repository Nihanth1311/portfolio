---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Contact from '../../components/Contact.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { withBase } from '../../lib/url';

// A page is built for every project with `caseStudy: true`.
export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.caseStudy && !data.draft);
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<Base title={`${data.title}, a project by ${site.name}`} description={data.summary} path={`/projects/${entry.id}/`}>
  <Nav />
  <main id="main">
    <header class="wrap top">
      <a class="top__back" href={withBase('/#projects')}>All projects</a>
      <h1>{data.title}</h1>
      <p class="top__summary">{data.summary}</p>
      <div class="top__actions">
        {
          data.link && (
            <a class="btn btn--solid" href={data.link} target="_blank" rel="noopener">
              {data.linkLabel ?? 'Open the live app'}
              <Icon name="external" />
            </a>
          )
        }
        {
          data.repo && (
            <a class="btn" href={data.repo} target="_blank" rel="noopener">
              Source code
              <Icon name="external" />
            </a>
          )
        }
        {data.note && <p class="top__note">{data.note}</p>}
      </div>
    </header>

    <div class="wrap body">
      <aside class="side">
        {
          data.stack.length > 0 && (
            <div>
              <h2>Built with</h2>
              <ul>
                {data.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
          )
        }
        {
          data.parts.length > 0 && (
            <div>
              <h2>The moving parts</h2>
              <dl>
                {data.parts.map((p) => (
                  <div>
                    <dt>{p.name}</dt>
                    <dd>{p.does}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )
        }
      </aside>

      <article class="prose">
        <Content />
      </article>
    </div>
  </main>
  <Contact />
</Base>

<style>
  .top {
    padding-block: clamp(1.5rem, 4vw, 3.5rem) clamp(2.5rem, 5vw, 4rem);
  }

  .top__back {
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--ink-2);
  }

  h1 {
    margin-top: 1rem;
    font-size: var(--step-5);
    font-weight: 700;
    font-stretch: 76%;
    line-height: 0.98;
  }

  .top__summary {
    margin-top: 1.25rem;
    max-width: 34ch;
    font-size: var(--step-2);
    font-weight: 500;
    font-stretch: 90%;
    line-height: 1.25;
  }

  .top__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.75rem;
  }

  .top__note {
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  .body {
    display: grid;
    gap: 3rem;
    padding-block: clamp(2.5rem, 5vw, 4rem) var(--section);
    border-top: 1px solid var(--ink);
  }

  /* On a phone the story comes first and the reference lists follow it. */
  .side {
    display: grid;
    gap: 2.25rem;
    align-content: start;
    order: 2;
  }

  .side h2 {
    font-size: var(--step-1);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
  }

  .side li,
  .side dl > div {
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--rule);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .side dt {
    font-weight: 600;
  }

  .side dd {
    color: var(--ink-2);
  }

  .prose {
    max-width: 66ch;
  }

  .prose :global(h2) {
    margin-top: 3rem;
    font-size: var(--step-3);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    margin-top: 2.25rem;
    font-size: var(--step-2);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote),
  .prose :global(pre) {
    margin-top: 1.1rem;
  }

  .prose :global(ul) {
    display: grid;
    gap: 0.6rem;
  }

  .prose :global(ul li) {
    position: relative;
    padding-left: 1.4rem;
  }

  .prose :global(ul li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.42rem;
    height: 0.42rem;
    background: var(--green);
  }

  .prose :global(strong) {
    font-weight: 650;
  }

  /* The lesson at the end of each story. */
  .prose :global(blockquote) {
    margin-inline: 0;
    padding: 1rem 1.25rem;
    background: var(--paper-2);
    border-radius: 3px;
    font-weight: 500;
  }

  .prose :global(blockquote p) {
    margin: 0;
  }

  .prose :global(pre) {
    padding: 1rem 1.25rem;
    background: var(--deep);
    color: var(--on-deep);
    border-radius: 3px;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  @media (min-width: 62rem) {
    .body {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      gap: 3rem;
    }

    .side {
      position: sticky;
      top: 2rem;
      order: 0;
    }
  }
</style>
