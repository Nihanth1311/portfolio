---
// The 1200x630 picture shown when the site's link is shared.
// It is a page so it can use the site's own fonts and colours; public/og.png is a screenshot of it.
import { Image } from 'astro:assets';
import '@fontsource-variable/anek-latin/wdth.css';
import '../styles/global.css';
import { site, trace } from '../data/site';
import portrait from '../assets/nihanth.png';

const max = Math.max(...trace.rows.map((r) => r.ms));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Share image</title>
  </head>
  <body>
    <div class="card">
      <div class="card__words">
        <p class="card__name">{site.name}</p>
        <h1>
          {site.headline.map((line) => <span>{line}</span>)}
        </h1>
        <div class="card__bars">
          {
            trace.rows.map((row) => (
              <div class="card__row">
                <span class="card__bar" data-kind={row.kind} style={`width:${(row.ms / max) * 100}%`} />
                <span class="card__ms">{row.ms} ms</span>
              </div>
            ))
          }
        </div>
        <p class="card__role">Full-stack engineer in {site.location}</p>
      </div>
      <div class="card__photo">
        <Image src={portrait} alt="" width={540} format="webp" quality={90} loading="eager" />
      </div>
    </div>
  </body>
</html>

<style>
  body {
    width: 1200px;
    height: 630px;
    overflow: hidden;
  }

  .card {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 56px;
    width: 1200px;
    height: 630px;
    padding: 56px 64px;
    background: var(--paper);
  }

  .card__words {
    display: flex;
    flex-direction: column;
  }

  .card__name {
    font-size: 30px;
    font-weight: 650;
    font-stretch: 85%;
  }

  h1 {
    margin-top: 28px;
    font-size: 84px;
    font-weight: 700;
    font-stretch: 76%;
    line-height: 0.98;
    letter-spacing: -0.015em;
  }

  h1 span {
    display: block;
    white-space: nowrap;
  }

  .card__bars {
    display: grid;
    gap: 12px;
    margin-top: auto;
  }

  .card__row {
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: 560px;
  }

  .card__bar {
    height: 30px;
    border-radius: 0 2px 2px 0;
  }

  .card__bar[data-kind='slow'] {
    background: var(--amber);
  }

  .card__bar[data-kind='fast'] {
    background: var(--green);
  }

  .card__ms {
    font-size: 26px;
    font-weight: 650;
    font-stretch: 85%;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .card__role {
    margin-top: 28px;
    font-size: 28px;
    color: var(--ink-2);
  }

  .card__photo {
    padding-top: 28px;
    background: var(--deep);
    border-radius: 6px;
    overflow: hidden;
  }

  .card__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }
</style>
