---
import { site } from '../data/site';
---

{
  site.quote && (
    <section class="quote" aria-label="What I work by">
      <div class="wrap">
        <blockquote>
          <p>{site.quote}</p>
        </blockquote>
      </div>
    </section>
  )
}

<style>
  .quote {
    background: var(--deep);
    color: var(--on-deep);
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .quote ::selection {
    background: var(--amber);
    color: var(--ink);
  }

  blockquote {
    margin: 0;
    position: relative;
    padding-left: clamp(2.25rem, 5vw, 4.5rem);
  }

  /* One large opening mark, hung in the margin so the words keep a clean left edge. */
  blockquote::before {
    content: '“';
    position: absolute;
    left: 0;
    top: -0.06em;
    font-size: clamp(4rem, 2rem + 8vw, 8rem);
    font-weight: 700;
    font-stretch: 76%;
    line-height: 1;
    color: var(--amber);
  }

  p {
    max-width: 30ch;
    font-size: clamp(2rem, 1rem + 4.4vw, 4.25rem);
    font-weight: 650;
    font-stretch: 78%;
    line-height: 1.04;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }
</style>
