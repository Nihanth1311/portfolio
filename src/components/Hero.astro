---
import { Image } from 'astro:assets';
import { site, facts } from '../data/site';
import Trace from './Trace.astro';
import Icon from './Icon.astro';
// To change the photo, replace src/assets/nihanth.png (a cut-out with a transparent background works best).
import portrait from '../assets/nihanth.png';
---

<section class="hero wrap">
  <div class="hero__top">
    <div class="hero__words">
      <h1 class="hero__title">
        {
          site.headline.map((line, i) => (
            <span class="hero__line" style={`--i:${i}`}>
              <span>{line}</span>
            </span>
          ))
        }
      </h1>

      <div class="hero__lede">
        <p>{site.intro}</p>
        <div class="hero__actions">
          <a class="btn btn--solid" href={`mailto:${site.email}`}>
            <Icon name="mail" />
            Email me
          </a>
          <a class="btn" href="#projects">See what I’ve built</a>
        </div>
      </div>
    </div>

    <div class="hero__me">
      <div class="hero__portrait">
        <Image
          src={portrait}
          alt={`Portrait of ${site.name}`}
          widths={[360, 540, 768]}
          sizes="(min-width: 62rem) 24rem, (min-width: 36rem) 20rem, 90vw"
          format="webp"
          quality={82}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <dl class="hero__facts">
        {
          facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <div class="hero__trace">
    <Trace />
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(1.5rem, 4vw, 3.5rem) var(--section);
  }

  .hero__top {
    display: grid;
    gap: 2.5rem;
  }

  /* The headline is sized from its own column, so each sentence stays on one line. */
  .hero__words {
    container-type: inline-size;
    align-self: center;
  }

  .hero__title {
    font-size: clamp(2rem, 11.9cqi, 5.5rem);
    font-weight: 700;
    font-stretch: 76%;
    line-height: 0.98;
    letter-spacing: -0.015em;
    text-wrap: initial;
  }

  /* Each line rises out of its own clip, one after the other. */
  .hero__line {
    display: block;
    overflow: clip;
    overflow-clip-margin: 0.12em;
    padding-bottom: 0.06em;
  }

  .hero__line > span {
    display: block;
    text-wrap: balance;
    animation: rise 900ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 110ms + 60ms);
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }

  .hero__lede {
    display: grid;
    gap: 1.75rem;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    max-width: 36rem;
    animation: settle 700ms ease-out 380ms both;
  }

  .hero__lede p {
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__me {
    display: grid;
    gap: 1.25rem;
    max-width: 24rem;
    animation: settle 700ms ease-out 300ms both;
  }

  /* The dark square of the board, with the cut-out standing on its bottom edge. */
  .hero__portrait {
    aspect-ratio: 5 / 5.4;
    padding-top: 7%;
    background: var(--deep);
    border-radius: 4px;
    overflow: hidden;
  }

  .hero__portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  .hero__facts {
    display: grid;
  }

  .hero__facts div {
    display: grid;
    grid-template-columns: 5.25rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.55rem;
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .hero__facts div:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .hero__facts dt {
    color: var(--ink-2);
  }

  .hero__facts dd {
    font-weight: 550;
  }

  .hero__trace {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    animation: settle 700ms ease-out 520ms both;
  }

  @keyframes settle {
    from {
      opacity: 0;
    }
  }

  @media (min-width: 36rem) and (max-width: 61.99rem) {
    .hero__me {
      max-width: none;
      grid-template-columns: 14rem minmax(0, 1fr);
      align-items: end;
      gap: 1.75rem;
    }
  }

  @media (min-width: 62rem) {
    .hero__top {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: 3.5rem;
      align-items: start;
    }

    .hero__me {
      justify-self: end;
      width: 100%;
    }
  }
</style>
