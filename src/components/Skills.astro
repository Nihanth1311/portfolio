---
import { skills } from '../data/site';
---

<section class="band" id="skills">
  <div class="wrap band__grid">
    <div class="band__head">
      <h2>What I work with</h2>
      <p class="band__lede">The tools I reach for, grouped by where they sit in the stack.</p>
    </div>

    <dl class="skills">
      {
        skills.map((s) => (
          <div class="skills__group">
            <dt>{s.group}</dt>
            <dd>{s.items.join(', ')}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .skills {
    display: grid;
    gap: 0 3rem;
  }

  .skills__group {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  dt {
    font-weight: 650;
    font-stretch: 85%;
    font-size: var(--step-1);
    line-height: 1.3;
  }

  dd {
    max-width: 46ch;
  }

  .skills__group:first-child {
    border-top-color: var(--ink);
  }

  @media (min-width: 44rem) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .skills__group:nth-child(2) {
      border-top-color: var(--ink);
    }
  }
</style>
