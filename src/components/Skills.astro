---
import Page from './Page.astro';
import { skills } from '../data/site';

// Each group gets its own sticker colour; tilts are fixed per position so builds are stable.
const tints = ['#fff2a0', '#d7ecff', '#ffd9e1', '#dff3e4', '#efe3ff', '#ffe4c7'];
const tilt = (i: number, k: number) => (((i * 7 + k * 13) % 9) - 4) * 0.9;
---

<Page n={5} title="my toolbox" id="skills">
  <h2 class="title" data-in>
    What I work with, <span class="hand title__hand">every day.</span>
  </h2>

  <div class="groups">
    {
      skills.map((g, i) => (
        <section class="group" data-in style={`--d:${i * 90}ms;--tint:${tints[i % tints.length]}`}>
          <h3 class="group__name hand">
            {g.group}
            <svg viewBox="0 0 120 10" preserveAspectRatio="none" aria-hidden="true">
              <path class="draw" style="--d:300ms;--dur:.6s" d="M2 6 C 30 2, 60 9, 90 5 S 115 4, 118 6" />
            </svg>
          </h3>
          <ul class="stickers">
            {g.items.map((t, k) => (
              <li style={`--r:${tilt(i, k)}deg;--k:${k}`}>{t}</li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Page>

<style>
  .title {
    max-width: 16ch;
  }

  .title__hand {
    display: inline-block;
    color: var(--red);
    font-size: 1.12em;
    rotate: -2deg;
  }

  .groups {
    display: grid;
    gap: 2.6rem 3rem;
    margin-top: 3rem;
  }

  @media (min-width: 46rem) {
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .group__name {
    position: relative;
    display: inline-block;
    font-size: 1.9rem;
    line-height: 1;
    color: var(--ink);
    margin-bottom: 1.1rem;
  }

  .group__name svg {
    position: absolute;
    left: 0;
    bottom: -0.4rem;
    width: 100%;
    height: 0.6rem;
    overflow: visible;
  }

  .group__name path {
    fill: none;
    stroke: var(--red);
    stroke-width: 2.4;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .stickers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .stickers li {
    padding: 0.45rem 0.85rem;
    background: var(--tint);
    border-radius: 4px;
    font-weight: 500;
    font-size: 0.95rem;
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.06),
      0 6px 10px -6px rgba(40, 30, 10, 0.35);
    rotate: var(--r);
    transition:
      rotate 300ms var(--spring),
      scale 300ms var(--spring),
      box-shadow 300ms ease;
  }

  /* Stickers slap down one after another when their group arrives. */
  :global(.js) .group .stickers li {
    opacity: 0;
    scale: 1.6;
    transition:
      opacity 250ms ease calc(var(--k) * 55ms + 250ms),
      scale 450ms var(--spring) calc(var(--k) * 55ms + 250ms),
      rotate 300ms var(--spring);
  }

  :global(.js) .group:global(.in) .stickers li {
    opacity: 1;
    scale: 1;
  }

  @media (hover: hover) {
    .stickers li:hover {
      rotate: 0deg;
      scale: 1.08;
      box-shadow:
        0 1px 0 rgba(0, 0, 0, 0.06),
        0 12px 16px -8px rgba(40, 30, 10, 0.4);
    }
  }
</style>
