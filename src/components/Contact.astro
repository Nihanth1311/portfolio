---
import Page from './Page.astro';
import { site } from '../data/site';
import { withBase } from '../lib/url';

interface Props {
  n?: number;
}
const { n = 7 } = Astro.props;
const year = new Date().getFullYear();
const v1 = 'https://github.com/Nihanth1311/portfolio/tree/version-1';
---

<Page n={n} title="say hello" id="contact" class="contact">
  <div class="letter" data-in data-letter style="--rot:-0.6deg;--from-rot:2deg">
    <svg class="plane" viewBox="0 0 400 160" aria-hidden="true">
      <path class="plane__trail draw" style="--d:500ms;--dur:1.6s" d="M10 140 C 80 150, 120 60, 190 80 S 260 150, 300 90 S 360 20, 392 30" />
      <g class="plane__body">
        <path d="M0 0 L-26 -10 L-20 0 L-26 10 Z" />
        <path d="M-20 0 L-26 10 L-14 4 Z" class="plane__fold" />
      </g>
    </svg>

    <p class="letter__dear hand">Dear reader,</p>
    <h2 class="letter__title">
      Hiring for a full-stack role? <span class="mark">Write to me.</span>
    </h2>
    <p class="letter__body">{site.availability} I reply to every email, usually within a day.</p>

    <div class="mail">
      <a class="mail__address" href={`mailto:${site.email}`}>{site.email}</a>
      <button class="btn btn--ghost mail__copy" type="button" data-copy={site.email}>
        <span data-copy-label>Copy email</span>
      </button>
      <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
    </div>

    <ul class="links">
      <li><a href={site.linkedin} target="_blank" rel="noopener me">LinkedIn ↗</a></li>
      <li><a href={site.github} target="_blank" rel="noopener me">GitHub ↗</a></li>
      <li><a href={withBase(site.resume)} download={site.resumeFileName}>Résumé (PDF) ↓</a></li>
    </ul>

    <p class="letter__sign hand">— Nihanth</p>
  </div>

  <footer class="foot">
    <span>{site.name} · {site.location} · © {year}</span>
    <span>drawn &amp; coded by hand · v2 · <a href={v1} target="_blank" rel="noopener">see version 1</a></span>
  </footer>
</Page>

<style>
  .letter {
    position: relative;
    max-width: 46rem;
    margin: 1rem auto 0;
    padding: clamp(2rem, 5vw, 3.4rem) clamp(1.5rem, 5vw, 3.4rem);
    background: var(--card);
    background-image: repeating-linear-gradient(transparent 0 2rem, #e8eef6 2rem calc(2rem + 1px));
    background-position: 0 1.2rem;
    box-shadow: 0 26px 50px -26px rgba(40, 30, 10, 0.5);
  }

  .plane {
    position: absolute;
    right: -2rem;
    top: -5rem;
    width: min(26rem, 80%);
    overflow: visible;
    pointer-events: none;
  }

  .plane__trail {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1.6;
    stroke-linecap: round;
    opacity: 0.6;
  }

  .plane__body {
    offset-path: path('M10 140 C 80 150, 120 60, 190 80 S 260 150, 300 90 S 360 20, 392 30');
    offset-distance: 100%;
    offset-rotate: auto;
  }

  :global(.js) .plane__body {
    offset-distance: 0%;
    opacity: 0;
  }

  :global(.js) .letter:global(.in) .plane__body {
    animation: fly 1.6s cubic-bezier(0.65, 0, 0.35, 1) 500ms forwards;
  }

  @keyframes fly {
    0% {
      offset-distance: 0%;
      opacity: 1;
    }
    100% {
      offset-distance: 100%;
      opacity: 1;
    }
  }

  .plane__body path {
    fill: var(--card);
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .plane__body .plane__fold {
    fill: #e9eef7;
  }

  .letter__dear {
    font-size: 1.9rem;
    color: var(--blue);
    line-height: 1;
  }

  .letter__title {
    margin-top: 1rem;
    max-width: 16ch;
  }

  .letter__body {
    margin-top: 1rem;
    color: var(--ink-2);
    max-width: 44ch;
  }

  .mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    margin-top: 1.8rem;
  }

  .mail__address {
    font-family: var(--hand);
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    font-weight: 700;
    color: var(--red);
    overflow-wrap: anywhere;
    line-height: 1.1;
  }

  .mail__copy:global(.is-done) {
    --btn-fg: var(--green);
    --btn-edge: var(--green);
    --btn-shadow: var(--green);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.6rem;
    margin-top: 1.6rem;
    font-weight: 500;
  }

  .letter__sign {
    margin-top: 2rem;
    text-align: right;
    font-size: 2.2rem;
    color: var(--ink);
    rotate: -3deg;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    max-width: 46rem;
    margin: 4rem auto 0;
    padding-top: 1rem;
    border-top: 1.5px dashed var(--rule);
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--ink-3);
    padding-bottom: 5rem;
  }
</style>
