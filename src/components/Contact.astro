---
import { site } from '../data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="contact" id="contact">
  <div class="wrap">
    <h2>Hiring for a full-stack role? Write to me.</h2>
    {site.availability && <p class="contact__lede">{site.availability}</p>}

    <div class="contact__mail">
      <a class="contact__address" href={`mailto:${site.email}`}>{site.email}</a>
      <button class="btn contact__copy" type="button" data-copy={site.email}>
        <span class="contact__icon" data-icon-copy><Icon name="copy" /></span>
        <span class="contact__icon" data-icon-done hidden><Icon name="check" /></span>
        <span data-copy-label>Copy email</span>
      </button>
      <span class="contact__status" role="status" aria-live="polite" data-copy-status></span>
    </div>

    <ul class="contact__links">
      <li>
        <a href={site.linkedin} target="_blank" rel="noopener me">LinkedIn <Icon name="external" size={16} /></a>
      </li>
      <li>
        <a href={site.github} target="_blank" rel="noopener me">GitHub <Icon name="external" size={16} /></a>
      </li>
      <li>
        <a href={site.resume} download={site.resumeFileName}>Download résumé <Icon name="download" size={16} /></a>
      </li>
    </ul>

    <p class="contact__base">
      <span>{site.name}, {site.location}</span>
      <span>© {year}</span>
    </p>
  </div>
</footer>

<style>
  .contact {
    background: var(--deep);
    color: var(--on-deep);
    padding-block: var(--section) 2rem;
  }

  .contact ::selection {
    background: var(--amber);
    color: var(--ink);
  }

  .contact :global(:focus-visible) {
    outline-color: var(--amber);
  }

  h2 {
    font-size: var(--step-5);
    font-weight: 700;
    font-stretch: 76%;
    line-height: 0.98;
    max-width: 16ch;
  }

  .contact__lede {
    margin-top: 1.5rem;
    font-size: var(--step-1);
    color: var(--on-deep-2);
  }

  .contact__mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .contact__address {
    font-size: clamp(1.35rem, 0.8rem + 2.6vw, 2.5rem);
    font-weight: 600;
    font-stretch: 85%;
    line-height: 1.2;
    overflow-wrap: anywhere;
    text-decoration-color: var(--amber);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
  }

  .contact__copy {
    --btn-edge: var(--on-deep-2);
    --btn-fg: var(--on-deep);
  }

  @media (hover: hover) {
    .contact__copy:hover {
      --btn-bg: var(--on-deep);
      --btn-edge: var(--on-deep);
      --btn-fg: var(--ink);
    }
  }

  .contact__icon {
    display: inline-flex;
  }

  .contact__icon[hidden] {
    display: none;
  }

  .contact__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.25rem;
    margin-top: 2.25rem;
  }

  .contact__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding-block: 0.5rem;
  }

  .contact__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: var(--section);
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule-deep);
    font-size: var(--step--1);
    color: var(--on-deep-2);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const label = button.querySelector<HTMLElement>('[data-copy-label]')!;
    const iconCopy = button.querySelector<HTMLElement>('[data-icon-copy]')!;
    const iconDone = button.querySelector<HTMLElement>('[data-icon-done]')!;
    const status = button.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
    const idle = label.textContent ?? 'Copy email';
    let timer = 0;

    button.addEventListener('click', async () => {
      const value = button.dataset.copy ?? '';
      let ok = true;
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        ok = false;
      }
      label.textContent = ok ? 'Copied' : 'Copy failed, select the address';
      iconCopy.hidden = ok;
      iconDone.hidden = !ok;
      if (status) status.textContent = ok ? 'Email address copied' : 'Could not copy the email address';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        label.textContent = idle;
        iconCopy.hidden = false;
        iconDone.hidden = true;
        if (status) status.textContent = '';
      }, 2000);
    });
  });
</script>
