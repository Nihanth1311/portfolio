---
import { education, achievements } from '../data/site';
---

<section class="band" id="background">
  <div class="wrap band__grid">
    <div class="band__head">
      <h2>Outside of work</h2>
    </div>

    <div class="bg">
      <div>
        <h3>Education</h3>
        <ul class="bg__list">
          {
            education.map((e) => (
              <li>
                <p class="bg__title">{e.school}</p>
                <p>
                  {e.detail}, {e.result}
                </p>
                <p class="bg__meta">
                  {e.years}
                  {e.place && <>, {e.place}</>}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3>Wins and side quests</h3>
        <ul class="bg__list">
          {
            achievements.map((a) => (
              <li>
                <p class="bg__title">{a.title}</p>
                <p>{a.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .bg {
    display: grid;
    gap: 3rem;
  }

  h3 {
    font-size: var(--step-2);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--ink);
  }

  .bg__list li {
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--rule);
  }

  .bg__list li:last-child {
    border-bottom: 0;
  }

  .bg__title {
    font-weight: 600;
  }

  .bg__meta {
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 50rem) {
    .bg {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
