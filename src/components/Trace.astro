---
import { trace } from '../data/site';
import Icon from './Icon.astro';

const max = Math.max(...trace.rows.map((r) => r.ms));
const ticks = [0, 0.25, 0.5, 0.75, 1].map((t) => ({ at: t, label: Math.round(t * max) }));
---

<figure class="trace" data-trace>
  <figcaption class="trace__caption">{trace.caption}</figcaption>

  <div class="trace__chart">
    <div class="trace__axis" aria-hidden="true">
      {
        ticks.map((t, i) => (
          <span class="trace__tick" style={`--at:${t.at}`} data-edge={i === 0 ? 'start' : i === ticks.length - 1 ? 'end' : undefined}>
            {t.label}
            {i === ticks.length - 1 ? ' ms' : ''}
          </span>
        ))
      }
    </div>

    {
      trace.rows.map((row) => (
        <div class="trace__row" data-row data-ms={row.ms} data-kind={row.kind}>
          <span class="trace__label">{row.label}</span>
          <span class="trace__value">
            <span data-value>{row.ms}</span> ms
          </span>
          <span class="trace__track">
            <span class="trace__bar" data-bar style={`--w:${row.ms / max}`} />
          </span>
        </div>
      ))
    }
  </div>

  <div class="trace__foot">
    <button class="btn" type="button" data-run>
      <Icon name="replay" />
      Send the request again
    </button>
    <p>{trace.note}</p>
  </div>
</figure>

<style>
  .trace {
    --label-col: 10.5rem;
    --value-col: 5.25rem;
  }

  .trace__caption {
    max-width: 44ch;
    font-size: var(--step-1);
    font-weight: 550;
    font-stretch: 90%;
    line-height: 1.25;
    margin-bottom: 1.75rem;
  }

  .trace__chart {
    display: grid;
    row-gap: 0.9rem;
    border-block: 1px solid var(--ink);
    padding-block: 0.6rem 1.4rem;
  }

  .trace__axis,
  .trace__row {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1rem;
    align-items: center;
  }

  .trace__axis {
    position: relative;
    height: 1.6rem;
    font-size: var(--step--1);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .trace__tick {
    position: absolute;
    left: calc(var(--at) * 100%);
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .trace__tick[data-edge='start'] {
    transform: none;
  }

  .trace__tick[data-edge='end'] {
    transform: translateX(-100%);
  }

  .trace__label {
    font-weight: 550;
  }

  .trace__value {
    font-variant-numeric: tabular-nums;
    font-weight: 650;
    font-stretch: 85%;
    font-size: var(--step-1);
    text-align: right;
    white-space: nowrap;
  }

  /* The track is ruled every 200 ms, so the bar can be read against the axis. */
  .trace__track {
    grid-column: 1 / -1;
    position: relative;
    display: block;
    height: 2.25rem;
    background-image: linear-gradient(to right, var(--rule) 1px, transparent 1px);
    background-size: 25% 100%;
    border-right: 1px solid var(--rule);
  }

  .trace__bar {
    position: absolute;
    inset: 0.3rem auto 0.3rem 0;
    width: calc(var(--w) * 100%);
    transform-origin: left center;
    border-radius: 0 2px 2px 0;
    background: var(--bar);
  }

  .trace__row[data-kind='slow'] {
    --bar: var(--amber);
  }

  .trace__row[data-kind='fast'] {
    --bar: var(--green);
  }

  .trace__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.5rem;
    margin-top: 1.25rem;
  }

  .trace__foot p {
    flex: 1 1 22rem;
    max-width: 52ch;
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.45;
  }

  @media (min-width: 48rem) {
    .trace__chart {
      row-gap: 0.5rem;
    }

    .trace__axis,
    .trace__row {
      grid-template-columns: var(--label-col) 1fr var(--value-col);
    }

    /* Axis ticks sit over the track column only. */
    .trace__axis {
      margin-left: calc(var(--label-col) + 1rem);
      margin-right: calc(var(--value-col) + 1rem);
      display: block;
    }

    .trace__label {
      grid-column: 1;
      grid-row: 1;
    }

    .trace__track {
      grid-column: 2;
      grid-row: 1;
      height: 2.75rem;
    }

    .trace__value {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>

<script>
  // Plays both requests side by side in real time, so the gap is felt and not only read.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-trace]').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('[data-run]');
    const rows = [...root.querySelectorAll<HTMLElement>('[data-row]')].map((row) => ({
      ms: Number(row.dataset.ms),
      bar: row.querySelector<HTMLElement>('[data-bar]')!,
      value: row.querySelector<HTMLElement>('[data-value]')!,
    }));
    const longest = Math.max(...rows.map((r) => r.ms));
    let frame = 0;

    const settle = () => {
      rows.forEach((r) => {
        r.bar.style.transform = '';
        r.value.textContent = String(r.ms);
      });
      if (button) button.disabled = false;
    };

    const run = () => {
      cancelAnimationFrame(frame);
      if (reduce.matches) return settle();
      if (button) button.disabled = true;
      const started = performance.now();

      const tick = (now: number) => {
        const elapsed = now - started;
        rows.forEach((r) => {
          const done = Math.min(elapsed, r.ms);
          r.bar.style.transform = `scaleX(${done / r.ms})`;
          r.value.textContent = String(Math.round(done));
        });
        if (elapsed < longest) frame = requestAnimationFrame(tick);
        else settle();
      };

      rows.forEach((r) => {
        r.bar.style.transform = 'scaleX(0)';
        r.value.textContent = '0';
      });
      frame = requestAnimationFrame(tick);
    };

    button?.addEventListener('click', run);

    // First run: once, after the headline has landed.
    if (!reduce.matches) {
      rows.forEach((r) => {
        r.bar.style.transform = 'scaleX(0)';
        r.value.textContent = '0';
      });
      if (button) button.disabled = true;
      window.setTimeout(run, 900);
    }
  });
</script>
